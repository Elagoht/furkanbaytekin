# Copy to .env.development (or .env) for "collage dev". The built binary reads
# these from its own environment.

# openssl rand -hex 32
COLLAGE_CSRF_KEY=

PORT=3000
HOST=localhost

# The Bloggo CMS the blog reads from, and the key it trusts this site with.
BLOG_API_URL=
BLOG_TRUSTED_FRONTEND_KEY=

# Where rendered pages and produced images are kept. Defaults to .cache.
CACHE_DIR=

# Bloggo sends it as X-Webhook-Secret to /api/webhook; unset, the webhook is refused.
WEBHOOK_SECRET=
